{
  "name": "@group-space/crypto-core",
  "version": "0.1.1",
  "private": false,
  "description": "The end-to-end encryption core of Group Space: field AEAD with context binding, the account keychain protocol, and the encrypted media container - extracted so the code that guards content can be read, tested, and rebuilt by anyone.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./e2ee": {
      "types": "./dist/e2ee.d.ts",
      "import": "./dist/e2ee.js",
      "default": "./dist/e2ee.js"
    },
    "./account-keys": {
      "types": "./dist/account-keys.d.ts",
      "import": "./dist/account-keys.js",
      "default": "./dist/account-keys.js"
    },
    "./aad": {
      "types": "./dist/aad.d.ts",
      "import": "./dist/aad.js",
      "default": "./dist/aad.js"
    },
    "./media-format": {
      "types": "./dist/media-format.d.ts",
      "import": "./dist/media-format.js",
      "default": "./dist/media-format.js"
    },
    "./media-range": {
      "types": "./dist/media-range.d.ts",
      "import": "./dist/media-range.js",
      "default": "./dist/media-range.js"
    },
    "./sw-decrypt": {
      "types": "./dist/sw-decrypt.d.ts",
      "import": "./dist/sw-decrypt.js",
      "default": "./dist/sw-decrypt.js"
    }
  },
  "dependencies": {
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^26.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/group-space/group-space-crypto.git"
  },
  "homepage": "https://github.com/group-space/group-space-crypto#readme",
  "bugs": {
    "url": "https://github.com/group-space/group-space-crypto/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "sw",
    "docs",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "AGENTS.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:crypto && npm run test:rewrap && npm run test:media-range && npm run test:interop && npm run test:vectors",
    "test:crypto": "tsx test/crypto-selftest.mts",
    "test:rewrap": "tsx test/rewrap-selftest.mts",
    "test:media-range": "tsx test/media-range-selftest.mts",
    "test:interop": "tsx test/sw-crypto-interop.mts",
    "test:vectors": "tsx test/vectors-selftest.mts",
    "vectors:generate": "tsx test/generate-vectors.mts",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
